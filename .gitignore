.venv/
.env
__pycache__/
*.pyc
processed/
# vectorstore/ (chunks.json + Qdrant store) IS committed intentionally: the
# deployed Streamlit app needs it to persist across deploys on Streamlit Cloud.
# Only the runtime Qdrant lock file stays ignored — it is never real data.
vectorstore/**/.lock
# local runtime artifacts (dev servers / pipes)
*.log
*.pid